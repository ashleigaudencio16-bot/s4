async function geocodePlace(q){
  // Photon is the primary geocoder; Nominatim is a fallback.
  const providers = [
    async()=>{
      const u='https://photon.komoot.io/api/?q='+encodeURIComponent(q)+'&limit=5&lang=pt';
      const r=await fetch(u,{headers:{'Accept':'application/json'}});
      if(!r.ok) throw Error('Photon HTTP '+r.status);
      const j=await r.json();
      const f=(j.features||[]).find(x=>x.geometry&&x.geometry.coordinates);
      if(!f) throw Error('Local não encontrado');
      const [lon,lat]=f.geometry.coordinates;
      return {lat:Number(lat),lon:Number(lon),label:[f.properties.name,f.properties.city,f.properties.state].filter(Boolean).join(', ')};
    },
    async()=>{
      const u='https://nominatim.openstreetmap.org/search?format=jsonv2&limit=5&q='+encodeURIComponent(q);
      const r=await fetch(u,{headers:{'Accept':'application/json'}});
      if(!r.ok) throw Error('Nominatim HTTP '+r.status);
      const j=await r.json();
      if(!j.length) throw Error('Local não encontrado');
      return {lat:Number(j[0].lat),lon:Number(j[0].lon),label:j[0].display_name};
    }
  ];
  let last;
  for(const provider of providers){
    try{
      const p=await provider();
      if(Number.isFinite(p.lat)&&Number.isFinite(p.lon)) return p;
    }catch(e){last=e}
  }
  throw Error(last&&last.message==='Local não encontrado'
    ? 'Não encontrei esse local. Tente escrever cidade e estado, por exemplo: Viamão, RS.'
    : 'Não consegui localizar esse endereço agora. Confira a internet e tente novamente.');
}

async function searchCity(inputId){
  const q=$(inputId).value.trim();
  if(!q){alert('Digite uma cidade, bairro ou instituição.');return}
  const box=inputId==='quickCity'?'nearbyResults':'searchResults';
  lastTarget=box;
  $(box).innerHTML='<p class="muted">Pesquisando instituições para "'+safe(q)+'"...</p>';
  try{
    // Primeiro tenta localizar instituições pelo nome digitado; se não houver
    // correspondência, interpreta o texto como cidade/bairro e busca no raio escolhido.
    const found=await searchInstitutionName(q,box);
    if(found) return;
    const p=await geocodePlace(q);
    lastCenter=[p.lat,p.lon];
    await searchAround(p.lat,p.lon,box);
  }catch(e){
    const suggested=await showPlaceSuggestions(q,box);
    if(!suggested)$(box).innerHTML='<p class="muted">'+safe(e.message)+'</p><button class="ghost" onclick="searchCity(\''+inputId+'\')">Tentar novamente</button>';
  }
}

async function searchInstitutionName(term,target){
  const escaped=term.replace(/[.*+?^${}()|[\]\\]/g,'\\$&').slice(0,80);
  const query='[out:json][timeout:25];(nwr["amenity"~"^(school|college|university)$"]["name"~"'+escaped.replace(/"/g,'\\\\"')+'",i];);out center tags 100;';
  try{
    const data=await fetchOverpass(query);
    const kind=$('kind')?.value||'all';
    const seen=new Set();
    const matches=(data.elements||[]).map(e=>{
      const t=e.tags||{},lat=e.lat??e.center?.lat,lon=e.lon??e.center?.lon;
      return {name:t.name||t['name:pt']||'Instituição sem nome',type:t.amenity||'school',
        lat:Number(lat),lon:Number(lon),
        address:[t['addr:street'],t['addr:housenumber'],t['addr:suburb'],t['addr:city']].filter(Boolean).join(', '),
        website:t.website||t['contact:website']||'',phone:t.phone||t['contact:phone']||''};
    }).filter(x=>Number.isFinite(x.lat)&&Number.isFinite(x.lon))
      .filter(x=>kind==='all'||(kind==='college'?['college','university'].includes(x.type):!['college','university'].includes(x.type)))
      .filter(x=>{const k=x.name.toLowerCase()+'|'+x.lat.toFixed(4)+'|'+x.lon.toFixed(4);if(seen.has(k))return false;seen.add(k);return true});
    if(!matches.length) return false;
    lastResults=matches;
    lastCenter=[matches[0].lat,matches[0].lon];
    if(map){map.setView(lastCenter,12);drawMarkers()}
    const status=$('mapStatus');
    if(status) status.textContent=matches.length+' correspondências pelo nome · dados do OpenStreetMap';
    $(target).innerHTML='<p class="muted small">'+matches.length+' instituição(ões) encontrada(s) pelo nome. Resultados disponíveis no OpenStreetMap.</p>'+
      matches.map((x,i)=>`<article class="school"><div class="row between"><h3>${i+1}. ${safe(x.name)}</h3><span class="tag">${typeLabel(x.type)}</span></div>${ratingHtml(x)}<p>${safe(x.address||'Endereço não informado no mapa')}</p>${x.phone?`<p>Telefone: ${safe(x.phone)}</p>`:''}${x.website?`<p><a href="${safeAttr(x.website)}" target="_blank" rel="noopener">Site da instituição ↗</a></p>`:''}<button class="secondary" onclick="focusPoint(${x.lat},${x.lon})">Ver no mapa</button></article>`).join('');
    return true;
  }catch(err){
    console.warn('Busca por nome indisponível; tentando busca por local:',err);
    return false;
  }
}

async function repeatLastSearch(){
  if(lastCenter) await searchAround(lastCenter[0],lastCenter[1],lastTarget);
}

async function fetchOverpass(query){
  const endpoints=[
    'https://overpass-api.de/api/interpreter?data=',
    'https://overpass.kumi.systems/api/interpreter?data=',
    'https://overpass.private.coffee/api/interpreter?data='
  ];
  let lastError=null;
  for(const base of endpoints){
    const controller=new AbortController();
    const timer=setTimeout(()=>controller.abort(),25000);
    try{
      const response=await fetch(base+encodeURIComponent(query),{
        method:'GET',
        headers:{'Accept':'application/json'},
        signal:controller.signal
      });
      if(!response.ok) throw Error('Servidor de dados respondeu '+response.status);
      const data=await response.json();
      if(!data||!Array.isArray(data.elements)) throw Error('Resposta inválida do mapa');
      return data;
    }catch(e){lastError=e}
    finally{clearTimeout(timer)}
  }
  throw lastError||Error('Serviços de mapa indisponíveis');
}

async function searchAround(lat,lon,target='nearbyResults'){
  lastCenter=[lat,lon];lastTarget=target;
  const kind=$('kind')?.value||'all';
  const radius=Number($('radius')?.value||12000);
  $(target).innerHTML='<p class="muted">Procurando escolas e faculdades num raio de '+(radius/1000)+' km...</p>';
  const query='[out:json][timeout:25];(nwr["amenity"~"^(school|college|university)$"](around:'+radius+','+lat+','+lon+'););out center tags;';
  try{
    const data=await fetchOverpass(query);
    const seen=new Set();
    const items=(data.elements||[]).map(e=>{
      const t=e.tags||{},la=e.lat??e.center?.lat,lo=e.lon??e.center?.lon;
      return {
        name:t.name||t['name:pt']||'Instituição sem nome',
        type:t.amenity||'school',
        lat:Number(la),lon:Number(lo),
        address:[t['addr:street'],t['addr:housenumber'],t['addr:suburb'],t['addr:city']].filter(Boolean).join(', '),
        website:t.website||t['contact:website']||'',
        phone:t.phone||t['contact:phone']||''
      };
    }).filter(x=>Number.isFinite(x.lat)&&Number.isFinite(x.lon))
      .filter(x=>{
        const k=x.name.toLowerCase()+'|'+x.lat.toFixed(4)+'|'+x.lon.toFixed(4);
        if(seen.has(k))return false;seen.add(k);return true;
      });
    lastResults=items.filter(x=>kind==='all'||(kind==='college'?['college','university'].includes(x.type):!['college','university'].includes(x.type)));
    if(map){map.setView([lat,lon],12);drawMarkers()}
    const status=$('mapStatus');
    if(status) status.textContent=lastResults.length+' instituições encontradas · dados do OpenStreetMap';
    const resultsHtml=lastResults.slice(0,100).map((x,i)=>
      `<article class="school"><div class="row between"><h3>${i+1}. ${safe(x.name)}</h3><span class="tag">${typeLabel(x.type)}</span></div>${ratingHtml(x)}<p>${safe(x.address||'Endereço não informado no mapa')}</p>${x.phone?`<p>Telefone: ${safe(x.phone)}</p>`:''}${x.website?`<p><a href="${safeAttr(x.website)}" target="_blank" rel="noopener">Site da instituição ↗</a></p>`:''}<button class="secondary" onclick="focusPoint(${x.lat},${x.lon})">Ver no mapa</button></article>`
    ).join('');
    $(target).innerHTML=resultsHtml||'<p class="muted">A busca foi concluída, mas não há instituições mapeadas nesse raio. Tente aumentar a distância ou pesquisar outra região. A cobertura depende dos dados do OpenStreetMap.</p>';
  }catch(e){
    console.warn('Erro na pesquisa S4 EDU:',e);
    $(target).innerHTML='<p class="muted">Não consegui carregar as instituições agora. O serviço de mapas pode estar ocupado ou sua conexão pode estar bloqueando a consulta.</p><button class="ghost" onclick="searchAround('+lat+','+lon+',\''+target+'\')">Tentar novamente</button>';
    const status=$('mapStatus');if(status)status.textContent='Falha ao consultar instituições.';
  }
}

function ratingKey(x){return String(x.name||'').toLowerCase().trim()+'|'+Number(x.lat).toFixed(4)+'|'+Number(x.lon).toFixed(4)}
function ratingHtml(x){
  const key=ratingKey(x),value=Number(user?.ratings?.[key]||0);
  const stars=[1,2,3,4,5].map(n=>`<button class="star-btn ${n<=value?'selected':''}" aria-label="Avaliar com ${n} estrelas" title="Avaliar com ${n} estrelas" onclick="rateInstitution('${encodeURIComponent(key)}',${n})">★</button>`).join('');
  return `<div class="rating-row"><span class="small muted">Sua avaliação:</span>${stars}<span class="small muted">${value?value+'/5':'Ainda não avaliada'}</span></div><p class="small muted">Avaliação pessoal salva somente neste navegador; não é uma nota oficial da instituição.</p>`;
}
function rateInstitution(encodedKey,value){
  if(!user)return;
  const key=decodeURIComponent(encodedKey);user.ratings=user.ratings||{};user.ratings[key]=value;
  try{setUser();}catch(e){alert('Não foi possível salvar a avaliação. O armazenamento do navegador pode estar cheio.');return}
  alert('Sua avaliação foi salva neste navegador. Obrigado!');
  if(lastTarget&&lastResults.length){
    const target=$(lastTarget);if(target){
      const old=target.innerHTML;
      // Atualiza apenas os cartões já exibidos, sem repetir a consulta.
      target.innerHTML=old.replace(/<div class="rating-row">[\s\S]*?<\/p>/g,'');
      // Re-renderiza os resultados a partir da lista atual.
      renderCurrentResults(target);
    }
  }
}
function renderCurrentResults(target){
  if(!target||!lastResults.length)return;
  target.innerHTML=lastResults.slice(0,100).map((x,i)=>`<article class="school"><div class="row between"><h3>${i+1}. ${safe(x.name)}</h3><span class="tag">${typeLabel(x.type)}</span></div>${ratingHtml(x)}<p>${safe(x.address||'Endereço não informado no mapa')}</p>${x.phone?`<p>Telefone: ${safe(x.phone)}</p>`:''}${x.website?`<p><a href="${safeAttr(x.website)}" target="_blank" rel="noopener">Site da instituição ↗</a></p>`:''}<button class="secondary" onclick="focusPoint(${x.lat},${x.lon})">Ver no mapa</button></article>`).join('');
}
function saveNote(){
  const title=$('noteTitle').value.trim(),body=$('noteBody').value.trim();
  if(!title||!body){alert('Preencha o título e o conteúdo da anotação.');return}
  user.notes=user.notes||[];user.notes.unshift({id:Date.now(),title,body,updated:new Date().toLocaleString('pt-BR')});
  try{setUser();$('noteTitle').value='';$('noteBody').value='';renderNotes();alert('Anotação salva!')}catch(e){user.notes.shift();alert('Não foi possível salvar. O armazenamento do navegador pode estar cheio.')}
}
function clearNoteForm(){$('noteTitle').value='';$('noteBody').value=''}
function renderNotes(){
  const box=$('notesList');if(!box||!user)return;
  const notes=user.notes||[];
  box.innerHTML=notes.length?notes.map(n=>`<article class="saved-item"><h3>${safe(n.title)}</h3><p>${safe(n.body)}</p><span class="small muted">${safe(n.updated||'')}</span><div class="row"><button class="ghost" onclick="editNote(${Number(n.id)})">Editar</button><button class="ghost" onclick="deleteNote(${Number(n.id)})">Excluir</button></div></article>`).join(''):'<p class="muted small">Você ainda não salvou anotações.</p>';
}
function editNote(id){
  const n=(user.notes||[]).find(x=>Number(x.id)===id);if(!n)return;
  $('noteTitle').value=n.title;$('noteBody').value=n.body;user.notes=user.notes.filter(x=>Number(x.id)!==id);setUser();renderNotes();$('noteTitle').focus();
}
function deleteNote(id){if(!confirm('Excluir esta anotação?'))return;user.notes=(user.notes||[]).filter(x=>Number(x.id)!==id);setUser();renderNotes()}
function saveDocument(){
  const input=$('documentFile'),file=input.files&&input.files[0];if(!file){alert('Escolha um arquivo primeiro.');return}
  if(file.size>1024*1024){alert('Este arquivo ultrapassa o limite de 1 MB.');return}
  const reader=new FileReader();reader.onload=()=>{
    user.documents=user.documents||[];user.documents.unshift({id:Date.now(),name:file.name,type:file.type||'application/octet-stream',data:reader.result,size:file.size,added:new Date().toLocaleString('pt-BR')});
    try{setUser();input.value='';renderDocuments();alert('Documento guardado neste navegador!')}catch(e){user.documents.shift();alert('Não foi possível guardar. O armazenamento do navegador pode estar cheio.')}
  };reader.onerror=()=>alert('Não foi possível ler esse arquivo.');reader.readAsDataURL(file);
}
function renderDocuments(){
  const box=$('documentsList');if(!box||!user)return;const docs=user.documents||[];
  box.innerHTML=docs.length?docs.map(d=>`<article class="saved-item"><h3>${safe(d.name)}</h3><p class="small muted">${(Number(d.size||0)/1024).toFixed(1)} KB · ${safe(d.added||'')}</p><div class="row"><button class="secondary" onclick="downloadDocument(${Number(d.id)})">Baixar arquivo</button><button class="ghost" onclick="deleteDocument(${Number(d.id)})">Excluir</button></div></article>`).join(''):'<p class="muted small">Nenhum documento guardado ainda.</p>';
}
function downloadDocument(id){
  const d=(user.documents||[]).find(x=>Number(x.id)===id);if(!d)return;
  const a=document.createElement('a');a.href=d.data;a.download=d.name;document.body.appendChild(a);a.click();a.remove();
}
function deleteDocument(id){if(!confirm('Excluir este documento?'))return;user.documents=(user.documents||[]).filter(x=>Number(x.id)!==id);setUser();renderDocuments()}
async function showPlaceSuggestions(query,target){
  try{
    const response=await fetch('https://photon.komoot.io/api/?q='+encodeURIComponent(query)+'&limit=5&lang=pt',{headers:{'Accept':'application/json'}});
    if(!response.ok)throw Error('Busca indisponível');
    const data=await response.json(),features=(data.features||[]).filter(f=>f.geometry?.coordinates);
    if(!features.length)return false;
    const options=features.map((f,i)=>{
      const p=f.properties||{},[lon,lat]=f.geometry.coordinates;
      const label=[p.name,p.city,p.state,p.country].filter(Boolean).join(', ');
      return `<button class="ghost" style="margin:4px" onclick="choosePlace(${Number(lat)},${Number(lon)},'${safeAttr(label).replace(/'/g,'&#39;')}','${target}')">${safe(label||'Sugestão '+(i+1))}</button>`;
    }).join('');
    const box=$(target);if(box)box.innerHTML='<p class="muted">Não encontrei uma correspondência exata. Você quis dizer uma destas opções?</p>'+options;
    return true;
  }catch(e){return false}
}
function choosePlace(lat,lon,label,target){
  lastCenter=[lat,lon];if(map){map.setView(lastCenter,13);drawMarkers()}
  searchAround(lat,lon,target);
}

function focusPoint(lat,lon){go('map');setTimeout(()=>{initMap();if(map){map.setView([lat,lon],16);drawMarkers()}},200)}

const tutorialSteps=[
 {emoji:'🔎',title:'Encontre instituições',text:'Pesquise escolas e faculdades pelo nome, cidade ou bairro. Você não precisa ativar o GPS para pesquisar.'},
 {emoji:'🗺️',title:'Explore o mapa',text:'Veja onde as instituições estão localizadas. Se quiser, ative o GPS para acompanhar sua posição em tempo real.'},
 {emoji:'⭐',title:'Avalie escolas',text:'Nos resultados, você pode dar uma nota de 1 a 5 estrelas. Suas avaliações ficam salvas neste navegador.'},
 {emoji:'📝',title:'Organize seus estudos',text:'Monte seu currículo estudantil, escreva anotações e guarde documentos na sua área pessoal.'},
 {emoji:'👤',title:'Personalize seu perfil',text:'Adicione sua foto, cidade, instituição e uma apresentação. Pronto: agora você já pode aproveitar o S4 EDU!'}
];
let tutorialIndex=0;
function startTutorial(force){
  if(!user)return;
  if(!force&&user.tutorialSeen)return;
  tutorialIndex=0;
  $('tutorialOverlay').classList.remove('hidden');
  renderTutorialStep();
}
function renderTutorialStep(){
  const step=tutorialSteps[tutorialIndex],card=$('tutorialCard');
  card.classList.remove('step-change');void card.offsetWidth;card.classList.add('step-change');
  $('tutorialEmoji').textContent=step.emoji;
  $('tutorialTitle').textContent=step.title;
  $('tutorialText').textContent=step.text;
  $('tutorialProgress').style.width=((tutorialIndex+1)/tutorialSteps.length*100)+'%';
  $('tutorialBack').disabled=tutorialIndex===0;
  $('tutorialNext').textContent=tutorialIndex===tutorialSteps.length-1?'Começar a usar':'Próximo';
  $('tutorialDots').innerHTML=tutorialSteps.map((_,i)=>`<span class="${i===tutorialIndex?'active':''}"></span>`).join('');
}
function tutorialNext(){if(tutorialIndex<tutorialSteps.length-1){tutorialIndex++;renderTutorialStep()}else finishTutorial()}
function tutorialBack(){if(tutorialIndex>0){tutorialIndex--;renderTutorialStep()}}
function finishTutorial(){
  $('tutorialOverlay').classList.add('hidden');
  if(user){user.tutorialSeen=true;try{setUser()}catch(e){console.warn('Não foi possível salvar a conclusão do tutorial',e)}}
}

function typeLabel(t){return t==='university'?'Universidade':t==='college'?'Faculdade':'Escola'}
function safe(s){return String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]))}
function safeAttr(s){return safe(s).replace(/'/g,'&#39;')}
let permissionAsked=false;
async function askPermissionsOnce(){if(permissionAsked)return;permissionAsked=true;/* A localização é solicitada somente quando o usuário escolhe usar o recurso. */if('Notification'in window&&Notification.permission==='default'){/* pedido fica a cargo do botão, evitando solicitar sem contexto */}}
async function askNotifications(){if(!('Notification'in window)){alert('Notificações não são suportadas neste navegador.');return}try{const p=await Notification.requestPermission();if(p==='granted'){alert('Notificações ativadas neste navegador.');new Notification('S4 EDU',{body:'Notificações ativadas com sucesso!'})}else{alert('Permissão de notificações não concedida. Você pode alterar isso nas configurações do navegador.')}}catch{alert('Não foi possível solicitar notificações.')}} 
function exportData(){if(!user)return;const blob=new Blob([JSON.stringify(user,null,2)],{type:'application/json'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='meus-dados-s4-edu.json';document.body.appendChild(a);a.click();a.remove();URL.revokeObjectURL(url)}
function deleteAccount(){if(!user)return;if(!confirm('Tem certeza de que deseja excluir a conta e os dados salvos neste navegador? Esta ação não pode ser desfeita.'))return;localStorage.removeItem('s4edu_user');user=null;alert('Dados locais excluídos.');logout()}
document.addEventListener('DOMContentLoaded',()=>{['quickCity','searchPlace'].forEach(id=>{const el=$(id);if(el)el.addEventListener('keydown',e=>{if(e.key==='Enter')searchCity(id)})});});
