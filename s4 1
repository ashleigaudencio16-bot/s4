<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
const $=id=>document.getElementById(id);
let user=null,map=null,markers=[],lastCenter=null,lastResults=[],lastTarget="nearbyResults";
let gpsWatchId=null,gpsMarker=null,gpsAccuracyCircle=null,lastGpsSearchPoint=null,lastGpsSearchTime=0;
function getUser(){try{return JSON.parse(localStorage.getItem('s4edu_user')||'null')}catch{return null}}
function setUser(){localStorage.setItem('s4edu_user',JSON.stringify(user))}
function ageFromDate(s){if(!s)return -1;const b=new Date(s+'T00:00:00'),t=new Date();let a=t.getFullYear()-b.getFullYear();if(t.getMonth()<b.getMonth()||(t.getMonth()===b.getMonth()&&t.getDate()<b.getDate()))a--;return a}
function showRegister(){$('login-form').classList.add('hidden');$('register-form').classList.remove('hidden')}
function showLogin(){$('register-form').classList.add('hidden');$('login-form').classList.remove('hidden')}
function register(){
 const name=$('regName').value.trim();
 const email=$('regEmail').value.trim();
 const dob=$('regDob').value;
 const role=document.querySelector('input[name="regRole"]:checked')?.value||'';
 // Valida um campo por vez e informa exatamente o que está faltando.
 if(!role){alert('Falta escolher uma opção: Pai / Mãe, Filho(a) ou Universitário.');document.querySelector('input[name="regRole"]')?.focus();return}
 if(!name){alert('Falta preencher o nome completo.');$('regName').focus();return}
 if(!email){alert('Falta preencher o e-mail.');$('regEmail').focus();return}
 if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){alert('O e-mail parece incorreto. Digite um endereço válido, como voce@gmail.com.');$('regEmail').focus();return}
 if(!dob){alert('Falta selecionar a data de nascimento.');$('regDob').focus();return}
 const age=ageFromDate(dob);
 if(age<0){alert('A data de nascimento informada é inválida. Confira e tente novamente.');$('regDob').focus();return}
 if(age<13){$('auth').classList.add('hidden');$('blocked').classList.remove('hidden');return}
 user={name,email,dob,role,photo:'',username:'',city:'',state:'',school:'',bio:'',resume:{},notes:[],documents:[],ratings:{}};
 setUser();enterApp()
}
function login(){const email=$('loginEmail').value.trim().toLowerCase();if(!email){alert('Digite seu e-mail.');return}const saved=getUser();if(!saved||saved.email.toLowerCase()!==email){alert('Conta não encontrada neste navegador. Crie seu cadastro primeiro.');return}user=saved;if(ageFromDate(user.dob)<13){$('auth').classList.add('hidden');$('blocked').classList.remove('hidden');return}enterApp()}
function enterApp(){user.notes=Array.isArray(user.notes)?user.notes:[];user.documents=Array.isArray(user.documents)?user.documents:[];user.ratings=user.ratings||{};$('auth').classList.add('hidden');$('blocked').classList.add('hidden');$('app').classList.remove('hidden');renderUser();loadResume();renderNotes();renderDocuments();askPermissionsOnce();if(!user.tutorialSeen)setTimeout(()=>startTutorial(false),500)}
function logout(){user=null;$('app').classList.add('hidden');$('blocked').classList.add('hidden');$('auth').classList.remove('hidden');showLogin()}
function renderUser(){const initials=(user.name||'S').split(' ').map(x=>x[0]).slice(0,2).join('').toUpperCase();$('topName').textContent=user.name;$('helloName').textContent=(user.name||'').split(' ')[0];$('topAvatar').src=user.photo||avatarSvg(initials);$('profilePhoto').src=user.photo||avatarSvg(initials);$('pName').value=user.name||'';$('pUsername').value=user.username||'';$('pEmail').value=user.email||'';$('pDob').value=user.dob||'';$('pCity').value=user.city||'';$('pState').value=user.state||'';$('pSchool').value=user.school||'';$('pBio').value=user.bio||''}
function avatarSvg(t){return 'data:image/svg+xml,'+encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100"><rect width="100" height="100" rx="24" fill="#eaf0ff"/><text x="50" y="60" font-size="34" text-anchor="middle" fill="#2457e6" font-family="Arial" font-weight="bold">${t}</text></svg>`)}
function uploadPhoto(e){const f=e.target.files[0];if(!f)return;if(f.size>1500000){alert('Escolha uma imagem de até 1,5 MB.');return}const r=new FileReader();r.onload=()=>{user.photo=r.result;setUser();renderUser()};r.readAsDataURL(f)}
function saveProfile(){user.name=$('pName').value.trim()||user.name;user.username=$('pUsername').value;user.city=$('pCity').value;user.state=$('pState').value;user.school=$('pSchool').value;user.bio=$('pBio').value;setUser();renderUser();alert('Perfil salvo neste navegador!')}
function go(page){document.querySelectorAll('.page').forEach(x=>x.classList.add('hidden'));$('page-'+page).classList.remove('hidden');document.querySelectorAll('.navbtn').forEach(x=>x.classList.toggle('active',x.dataset.page===page));if(page==='map'){setTimeout(()=>{initMap();if(map){map.invalidateSize();if(lastCenter)map.setView(lastCenter,13);drawMarkers()}},180)}if(page==='notes')renderNotes();if(page==='documents')renderDocuments();if(page==='curiosities'){if(!$('curiosityCity').value.trim())$('curiosityCity').value=user.city?`${user.city}${user.state?', '+user.state:''}`:'Gravataí, RS';checkCuriosityRefresh()}}

const CURIOSITY_REFRESH_KEY='s4edu_curiosity_last_refresh';
const CURIOSITY_SCHOOLS_KEY='s4edu_curiosity_osm_schools';
let curiosityTimer=null;
function checkCuriosityRefresh(){
 const last=Number(localStorage.getItem(CURIOSITY_REFRESH_KEY)||0);
 if(!last || Date.now()-last>24*60*60*1000) refreshCuriosities(true);
 if(!curiosityTimer) curiosityTimer=setInterval(()=>{if(!$('page-curiosities').classList.contains('hidden'))refreshCuriosities(true)},6*60*60*1000);
}
async function refreshCuriosities(silent=false){
 const city=$('curiosityCity').value.trim()||'Gravataí, RS';
 const status=$('curiosityStatus');
 const list=$('curiosityLiveList');
 if(status)status.textContent='Consultando escolas no mapa colaborativo…';
 if(list)list.innerHTML='<p class="muted small">Carregando instituições…</p>';
 try{
  // A busca de escolas é baseada em dados abertos do OpenStreetMap para a cidade informada.
  const geoUrl='https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&q='+encodeURIComponent(city+', Brasil');
  const geoResp=await fetch(geoUrl,{headers:{'Accept':'application/json'}});
  if(!geoResp.ok)throw new Error('Não foi possível localizar a cidade.');
  const geo=await geoResp.json();
  if(!geo.length)throw new Error('Cidade não encontrada. Confira o nome e tente novamente.');
  const lat=Number(geo[0].lat),lon=Number(geo[0].lon);
  const query='[out:json][timeout:25];(node["amenity"="school"](around:15000,'+lat+','+lon+');way["amenity"="school"](around:15000,'+lat+','+lon+');relation["amenity"="school"](around:15000,'+lat+','+lon+');node["amenity"="college"](around:15000,'+lat+','+lon+');way["amenity"="college"](around:15000,'+lat+','+lon+'););out center tags;';
  const api='https://overpass-api.de/api/interpreter?data='+encodeURIComponent(query);
  const response=await fetch(api);
  if(!response.ok)throw new Error('O serviço de mapas está temporariamente indisponível.');
  const data=await response.json();
  const schools=(data.elements||[]).map(el=>({id:String(el.id),name:el.tags?.name||el.tags?.['name:pt']||'',type:el.tags?.amenity||'school',lat:el.lat??el.center?.lat,lon:el.lon??el.center?.lon})).filter(x=>x.name).sort((a,b)=>a.name.localeCompare(b.name,'pt-BR'));
  const old=JSON.parse(localStorage.getItem(CURIOSITY_SCHOOLS_KEY)||'[]');
  const oldIds=new Set(old.map(x=>x.id));
  const added=schools.filter(x=>!oldIds.has(x.id));
  localStorage.setItem(CURIOSITY_SCHOOLS_KEY,JSON.stringify(schools));
  localStorage.setItem(CURIOSITY_REFRESH_KEY,String(Date.now()));
  const when=new Date().toLocaleString('pt-BR');
  if($('curiosityUpdated'))$('curiosityUpdated').textContent='Atualizado em '+when;
  if(status)status.textContent=schools.length+' instituições encontradas em até 15 km de '+city+'. Fonte: OpenStreetMap.';
  if(list){
   if(!schools.length)list.innerHTML='<p class="muted small">Nenhuma escola cadastrada foi encontrada nessa região. Isso não significa que não existam escolas por perto.</p>';
   else list.innerHTML='<p class="small muted">'+schools.length+' instituição(ões) cadastrada(s) no OpenStreetMap:</p>'+schools.slice(0,35).map(x=>'<div class="curiosity-item"><div><strong>'+escapeHtml(x.name)+'</strong><p class="small muted">'+(x.type==='college'?'Faculdade / ensino superior':'Escola')+'</p></div><a target="_blank" rel="noopener" href="https://www.openstreetmap.org/'+(x.id.startsWith('n')?'node':x.id.startsWith('w')?'way':'relation')+'/'+x.id.replace(/^[nwr]/,'')+'">Ver mapa ↗</a></div>').join('');
  }
  if(!silent && 'Notification' in window && Notification.permission==='granted')new Notification('S4 EDU: curiosidades atualizadas',{body:schools.length+' instituições encontradas em '+city+'.'});
  if(silent && added.length && 'Notification' in window && Notification.permission==='granted')new Notification('Novas escolas encontradas no S4 EDU',{body:added.length+' novo(s) cadastro(s) no OpenStreetMap para '+city+'.'});
 }catch(err){
  if(status)status.textContent=err.message||'Não foi possível atualizar agora. Tente novamente mais tarde.';
  if(list)list.innerHTML='<p class="muted small">Não foi possível consultar a lista ao vivo. Verifique a internet e tente novamente.</p>';
 }
}
function escapeHtml(value){return String(value).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
async function enableCuriosityAlerts(){
 if(!('Notification' in window)){alert('Este navegador não oferece notificações.');return}
 const permission=await Notification.requestPermission();
 if(permission==='granted'){alert('Notificações ativadas! O S4 EDU avisará sobre novos cadastros encontrados quando a aba estiver aberta e conseguir atualizar.');if(!$('page-curiosities').classList.contains('hidden'))refreshCuriosities()}
 else alert('As notificações não foram autorizadas. Você ainda pode consultar a aba manualmente.');
}
function saveResume(){user.resume={education:$('rEducation').value,school:$('rSchool').value,courses:$('rCourses').value,certificates:$('rCertificates').value,languages:$('rLanguages').value,skills:$('rSkills').value,projects:$('rProjects').value,goals:$('rGoals').value};setUser();alert('Currículo salvo!')}
function loadResume(){const r=user.resume||{};for(const [id,k] of Object.entries({rEducation:'education',rSchool:'school',rCourses:'courses',rCertificates:'certificates',rLanguages:'languages',rSkills:'skills',rProjects:'projects',rGoals:'goals'}))$(id).value=r[k]||''}
function printResume(){saveResume();const r=user.resume||{};const w=window.open('','_blank');if(!w){alert('Permita pop-ups para gerar o PDF.');return}const esc=s=>String(s||'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));w.document.write(`<html><head><title>Currículo estudantil</title><style>body{font:15px Arial;padding:40px;color:#172033}h1{color:#2457e6}h2{margin:22px 0 5px;font-size:16px}p{white-space:pre-wrap}
 .tutorial-overlay{position:fixed;inset:0;background:rgba(8,17,38,.76);backdrop-filter:blur(7px);z-index:3000;display:grid;place-items:center;padding:18px;animation:fadeIn .35s ease}
 .tutorial-card{width:min(100%,560px);background:#fff;border-radius:24px;padding:26px;box-shadow:0 24px 80px #0005;position:relative;overflow:hidden;animation:popIn .45s cubic-bezier(.2,.8,.2,1)}
 .tutorial-top{display:flex;align-items:center;justify-content:space-between;gap:10px}
 .tutorial-progress{height:6px;background:#e9edf5;border-radius:99px;overflow:hidden;margin:18px 0}
 .tutorial-progress span{display:block;height:100%;background:linear-gradient(90deg,var(--blue),var(--cyan));border-radius:99px;transition:width .35s ease}
 .tutorial-visual{height:155px;border-radius:18px;background:linear-gradient(135deg,#edf2ff,#e3fbff);display:grid;place-items:center;margin:14px 0 20px;position:relative;overflow:hidden}
 .tutorial-emoji{font-size:72px;filter:drop-shadow(0 8px 10px #17203320);animation:floaty 2.4s ease-in-out infinite}
 .tutorial-orbit{position:absolute;width:120px;height:120px;border:2px dashed #2457e655;border-radius:50%;animation:spin 12s linear infinite}
 .tutorial-card h2{font-size:25px;margin:0 0 8px;color:var(--navy)}
 .tutorial-card p{color:var(--muted);line-height:1.6;margin:0}
 .tutorial-dots{display:flex;gap:7px;justify-content:center;margin:18px 0}
 .tutorial-dots span{width:8px;height:8px;border-radius:50%;background:#d0d5dd;transition:all .25s}
 .tutorial-dots span.active{width:24px;border-radius:99px;background:var(--blue)}
 .tutorial-actions{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:20px}
 .tutorial-actions .right{display:flex;gap:8px}
 .tutorial-close{background:transparent;color:#667085;padding:7px 10px}
 .tutorial-card.step-change{animation:slideUp .3s ease}
 @keyframes fadeIn{from{opacity:0}to{opacity:1}}
 @keyframes popIn{from{opacity:0;transform:translateY(18px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}
 @keyframes slideUp{from{opacity:.35;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
 @keyframes floaty{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-9px) rotate(3deg)}}
 @keyframes spin{to{transform:rotate(360deg)}}
 @media(prefers-reduced-motion:reduce){.tutorial-overlay,.tutorial-card,.tutorial-emoji,.tutorial-orbit{animation:none!important;transition:none!important}}

</style></head><body><h1>${esc(user.name)}</h1><p>${esc(user.email)}</p>${[['Formação',r.education],['Instituição',r.school],['Cursos',r.courses],['Certificados',r.certificates],['Idiomas',r.languages],['Habilidades',r.skills],['Projetos e experiências',r.projects],['Objetivos',r.goals]].map(([a,b])=>`<h2>${a}</h2><p>${esc(b)}</p>`).join('')}<script>window.onload=()=>window.print()<\/script></body></html>`);w.document.close()}
function initMap(){
  if(map)return;
  if(!window.L){const el=$('mapStatus');if(el)el.textContent='Biblioteca do mapa não carregou. Confira a internet e recarregue a página.';return}
  map=L.map('map',{preferCanvas:true,zoomControl:true}).setView([-30.03,-51.23],10);
  // Usa o endereço oficial dos tiles OSM e mantém a atribuição visível.
  const osmLayer=L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{
    attribution:'&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap contributors</a>',
    maxZoom:19,
    maxNativeZoom:19,
    updateWhenIdle:true,
    keepBuffer:2
  }).addTo(map);
  osmLayer.on('tileerror',()=>{const el=$('mapStatus');if(el)el.textContent='Algumas partes do mapa não carregaram. Verifique a conexão ou toque em “Atualizar mapa”.'});
  osmLayer.on('load',()=>{const el=$('mapStatus');if(el&&el.textContent.includes('carregaram'))el.textContent='Mapa carregado · dados colaborativos OpenStreetMap';});
  L.control.scale({metric:true,imperial:false,position:'bottomleft'}).addTo(map);
  if(lastCenter)map.setView(lastCenter,13);
  drawMarkers();
}
function refreshMap(){
  if(!map)initMap();
  if(!map)return;
  map.invalidateSize(true);
  map.eachLayer(layer=>{if(layer instanceof L.TileLayer)layer.redraw()});
  const status=$('mapStatus');
  if(status)status.textContent='Atualizando os blocos visíveis do mapa…';
  setTimeout(()=>{if(status&&status.textContent.includes('Atualizando'))status.textContent='Mapa atualizado na tela. A base cartográfica é mantida pela comunidade OpenStreetMap.';},1200);
}
function clearMarkers(){if(!map)return;markers.forEach(m=>map.removeLayer(m));markers=[]}
function drawMarkers(){if(!map)return;clearMarkers();lastResults.forEach(x=>{const m=L.marker([x.lat,x.lon]).addTo(map).bindPopup(`<b>${safe(x.name)}</b><br>${safe(typeLabel(x.type))}`);markers.push(m)})}
function gpsError(err){
  const messages={
    1:'Permissão de localização negada. Libere a localização nas configurações do navegador.',
    2:'O dispositivo não conseguiu determinar a posição. Verifique o GPS e tente novamente.',
    3:'O GPS demorou para responder. Mantenha o app aberto e tente novamente.'
  };
  const msg=messages[err.code]||'Não foi possível obter a localização.';
  const status=$('mapStatus');if(status)status.textContent=msg;
}
function updateGPSPosition(pos){
  const lat=pos.coords.latitude,lon=pos.coords.longitude,accuracy=pos.coords.accuracy||0;
  lastCenter=[lat,lon];
  if(!map)initMap();
  if(map){
    const point=[lat,lon];
    if(!gpsMarker)gpsMarker=L.circleMarker(point,{radius:9,color:'#fff',weight:3,fillColor:'#1769ff',fillOpacity:1}).addTo(map).bindPopup('Sua localização em tempo real');
    else gpsMarker.setLatLng(point);
    if(!gpsAccuracyCircle)gpsAccuracyCircle=L.circle(point,{radius:accuracy,color:'#1769ff',weight:1,opacity:.45,fillColor:'#1769ff',fillOpacity:.08}).addTo(map);
    else gpsAccuracyCircle.setLatLng(point).setRadius(accuracy);
    map.setView(point,Math.max(map.getZoom(),14));
  }
  const status=$('mapStatus');
  if(status)status.textContent='GPS ativo · precisão aproximada de '+Math.round(accuracy)+' m · atualizado às '+new Date().toLocaleTimeString('pt-BR');
  // Refresh nearby institutions only after meaningful movement or 60 seconds.
  const now=Date.now();
  const moved=!lastGpsSearchPoint||distanceMeters(lastGpsSearchPoint[0],lastGpsSearchPoint[1],lat,lon)>600;
  if(moved||now-lastGpsSearchTime>60000){
    lastGpsSearchPoint=[lat,lon];lastGpsSearchTime=now;
    searchAround(lat,lon,'gpsResults');
  }
}
function distanceMeters(lat1,lon1,lat2,lon2){
  const rad=x=>x*Math.PI/180,R=6371000;
  const dLat=rad(lat2-lat1),dLon=rad(lon2-lon1);
  const a=Math.sin(dLat/2)**2+Math.cos(rad(lat1))*Math.cos(rad(lat2))*Math.sin(dLon/2)**2;
  return 2*R*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));
}
function startLiveGPS(){
  if(!navigator.geolocation){alert('Este navegador não oferece geolocalização.');return}
  if(!window.isSecureContext){alert('Para usar o GPS, abra o S4 EDU por um endereço HTTPS ou localhost. Abrir o arquivo diretamente pode bloquear a localização.');}
  go('map');
  setTimeout(()=>{initMap();if(map)map.invalidateSize()},180);
  if(gpsWatchId!==null)navigator.geolocation.clearWatch(gpsWatchId);
  const status=$('mapStatus');if(status)status.textContent='Solicitando permissão do GPS...';
  gpsWatchId=navigator.geolocation.watchPosition(
    updateGPSPosition,
    gpsError,
    {enableHighAccuracy:true,timeout:20000,maximumAge:3000}
  );
}
function stopLiveGPS(){
  if(gpsWatchId!==null){navigator.geolocation.clearWatch(gpsWatchId);gpsWatchId=null}
  const status=$('mapStatus');if(status)status.textContent='GPS pausado. Sua posição não está mais sendo atualizada.';
}
