.profile-head{display:flex;align-items:center;gap:16px}.profile-photo{width:78px;height:78px;border-radius:22px;object-fit:cover;background:#edf2ff}.upload{font-size:12px;color:var(--blue);font-weight:700;cursor:pointer}.upload input{display:none}
footer{text-align:center;color:#98a2b3;font-size:12px;padding:20px}
@media(max-width:850px){.layout{grid-template-columns:1fr}.sidebar{position:static;display:flex;overflow:auto;gap:4px}.navbtn{white-space:nowrap;width:auto}.cards{grid-template-columns:1fr 1fr}.auth-shell{grid-template-columns:1fr}.auth-side{display:none}}
@media(max-width:520px){.wrap{padding:12px}.top{padding:10px 12px}.hero{padding:22px}.grid2,.cards{grid-template-columns:1fr}.panel{padding:15px}#map{height:320px}}

 .tutorial-overlay{position:fixed;inset:0;background:rgba(8,17,38,.76);backdrop-filter:blur(7px);z-index:3000;display:grid;place-items:center;padding:18px;animation:fadeIn .35s ease}
 .tutorial-card{width:min(100%,560px);background:#fff;border-radius:24px;padding:26px;box-shadow:0 24px 80px #0005;position:relative;overflow:hidden;animation:popIn .45s cubic-bezier(.2,.8,.2,1)}
 .tutorial-top{display:flex;align-items:center;justify-content:space-between;gap:10px}
 .tutorial-progress{height:6px;background:#e9edf5;border-radius:99px;overflow:hidden;margin:18px 0}
 .tutorial-progress span{display:block;height:100%;background:linear-gradient(90deg,var(--blue),var(--cyan));border-radius:99px;transition:width .35s ease}
 .tutorial-visual{height:155px;border-radius:18px;background:linear-gradient(135deg,#edf2ff,#e3fbff);display:grid;place-items:center;margin:14px 0 20px;position:relative;overflow:hidden}
 .tutorial-emoji{font-size:72px;filter:drop-shadow(0 8px 10px #17203320);animation:floaty 2.4s ease-in-out infinite}
 .tutorial-orbit{position:absolute;width:120px;height:120px;border:2px dashed #2457e655;border-radius:50%;animation:spin 12s linear infinite}
 .tutorial-card h2{font-size:25px;margin:0 0 8px;color:var(--navy)}
 .tutorial-card p{color:var(--muted);line-height:1.6;margin:0}
 .tutorial-dots{display:flex;gap:7px;justify-content:center;margin:18px 0}
 .tutorial-dots span{width:8px;height:8px;border-radius:50%;background:#d0d5dd;transition:all .25s}
 .tutorial-dots span.active{width:24px;border-radius:99px;background:var(--blue)}
 .tutorial-actions{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:20px}
 .tutorial-actions .right{display:flex;gap:8px}
 .tutorial-close{background:transparent;color:#667085;padding:7px 10px}
 .tutorial-card.step-change{animation:slideUp .3s ease}
 @keyframes fadeIn{from{opacity:0}to{opacity:1}}
 @keyframes popIn{from{opacity:0;transform:translateY(18px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}
 @keyframes slideUp{from{opacity:.35;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
 @keyframes floaty{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-9px) rotate(3deg)}}
 @keyframes spin{to{transform:rotate(360deg)}}
 @media(prefers-reduced-motion:reduce){.tutorial-overlay,.tutorial-card,.tutorial-emoji,.tutorial-orbit{animation:none!important;transition:none!important}}


.nav-badge{display:inline-flex;align-items:center;justify-content:center;color:#2457e6;font-size:20px;margin-left:auto}
