header{background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:500}.top{max-width:1180px;margin:auto;padding:13px 22px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.top-right{display:flex;align-items:center;gap:10px}.avatar{width:35px;height:35px;border-radius:50%;object-fit:cover;background:#eaf0ff;display:grid;place-items:center;color:var(--blue);font-weight:800}
.hero{background:var(--navy);color:white;border-radius:24px;padding:30px;position:relative;overflow:hidden;margin:18px 0}.hero:after{content:"S4";position:absolute;right:22px;bottom:-38px;font-size:150px;font-weight:1000;color:#ffffff0d;letter-spacing:-12px}.hero h1{font-size:clamp(28px,5vw,48px);line-height:1.02;margin:12px 0}.hero p{color:#c9d5f2;max-width:550px}.eyebrow{font-size:11px;letter-spacing:2px;font-weight:900;color:var(--cyan)}
.layout{display:grid;grid-template-columns:230px 1fr;gap:20px}.sidebar{background:#fff;border:1px solid var(--line);border-radius:18px;padding:12px;height:max-content;position:sticky;top:82px}.navbtn{width:100%;text-align:left;background:transparent;color:#475467;margin:3px 0;display:flex;gap:12px;align-items:center}.navbtn.active{background:#edf2ff;color:var(--blue)}.content{min-width:0}.panel{background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px;margin-bottom:16px}.panel h2{margin:0 0 6px;font-size:21px}.panel h3{margin:0 0 8px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}.field{display:flex;flex-direction:column;gap:6px;margin:12px 0}.field label{font-size:13px;font-weight:750;color:#344054}.field input,.field textarea,.field select,.searchbar input{width:100%;border:1px solid #d7deea;border-radius:11px;padding:12px;background:#fff;outline:none}.field input:focus,.field textarea:focus{border-color:var(--blue);box-shadow:0 0 0 3px #2457e61a}.field textarea{min-height:85px;resize:vertical}.row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.between{justify-content:space-between}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.stat{padding:16px;border-radius:15px;background:#f1f5ff}.stat strong{display:block;font-size:24px;color:var(--navy)}#map{height:390px;border-radius:15px;z-index:1}.searchbar{display:flex;gap:8px}.searchbar input{flex:1;min-width:0}.school{border:1px solid var(--line);padding:14px;border-radius:14px;margin-top:10px}.school h3{font-size:16px}.school p{font-size:13px;color:var(--muted);margin:5px 0}.tag{display:inline-block;background:#eaf0ff;color:#234bc2;padding:4px 8px;border-radius:99px;font-size:11px;font-weight:800}
 .rating-row{display:flex;align-items:center;gap:4px;flex-wrap:wrap;margin:7px 0}.star-btn{background:transparent;color:#d0d5dd;padding:2px 4px;font-size:22px;line-height:1;border-radius:6px}.star-btn.selected,.star-btn:hover{color:#e5a000}.saved-item{border:1px solid var(--line);border-radius:12px;padding:13px;margin-top:10px}.saved-item h3{margin:0 0 6px;font-size:15px}.saved-item p{white-space:pre-wrap;overflow-wrap:anywhere}.saved-item .row{margin-top:8px}
.auth-shell{min-height:100vh;display:grid;grid-template-columns:1.05fr .95fr;background:#fff}.auth-side{background:var(--navy);color:#fff;padding:clamp(28px,6vw,75px);display:flex;flex-direction:column;justify-content:space-between;overflow:hidden;position:relative}.auth-side:after{content:"S4 EDU";font-size:clamp(70px,12vw,170px);font-weight:1000;letter-spacing:-12px;color:#ffffff0b;position:absolute;bottom:4%;left:5%;white-space:nowrap}.auth-side p{color:#c9d5f2;max-width:450px}.auth-main{display:grid;place-items:center;padding:25px}.auth-card{width:min(100%,430px)}.auth-card h1{font-size:32px;margin:22px 0 6px}.auth-card .brand{margin-bottom:35px}.role-options{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:12px 0 16px}.role-option{border:1px solid #d7deea;border-radius:12px;padding:12px 8px;text-align:center;cursor:pointer;background:#fff;color:#111827;font-size:13px;font-weight:700}.role-option:has(input:checked){border:2px solid #2457e6;background:#eef3ff}.role-option input{accent-color:#2457e6;margin:0 0 7px}.role-option span{display:block}@media(max-width:420px){.role-options{grid-template-columns:1fr}}
